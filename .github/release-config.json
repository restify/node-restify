{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "versioning": "default",
  "prerelease": false,
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "json",
          "path": ".github/prerelease-manifest.json",
          "jsonpath": "$[\".\"]"
        }
      ]
    }
  }
}
